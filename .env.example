# Copy to .env for local runs: cxp-server loads it at startup (dotenvy), however it
# is started. dotenvy never overrides a variable already set, so a deployment's
# real environment wins.

# otto-cxp's OWN database (not the platform's). `podman compose up -d` starts one
# on port 15435. CXP_DATABASE_URL wins; DATABASE_URL is the fallback, and is what
# production sets. Its superuser is fine here only because this is not a deployment:
# CXP_PUBLIC_URL and CXP_RESOURCE_URI are loopback, FLY_APP_NAME is unset, and this
# Postgres hosts no otto_platform, otto_factory, or otto_flags database. Change any of
# those (e.g. a tunnel exposing a dev server, or one Postgres for every otto service)
# and boot refuses a superuser, any superuser-equivalent role, or one that can connect
# to another service's database (docs/deploy/fly.md, "Database role"). Then connect as
# a local least-privilege owner instead, made as the runbook makes cxp_server:
#   CREATE ROLE cxp_dev LOGIN PASSWORD 'cxp_dev'; GRANT otto_app TO cxp_dev;
#   CREATE DATABASE otto_cxp_dev OWNER cxp_dev;   -- then point DATABASE_URL at it
DATABASE_URL=postgres://cxp:cxp@localhost:15435/otto_cxp
# CXP_DATABASE_URL=

# Public origin of this service (no path). The token audience defaults to {this}/mcp.
CXP_PUBLIC_URL=http://localhost:8080
# CXP_RESOURCE_URI=http://localhost:8080/mcp

# The otto platform (OAuth authorization server, identity, billing), and the two
# secrets it printed when this resource server was registered there:
#   otto-platform-server resource register <resource-uri> --name otto-cxp --scopes cxp:read,cxp:write --default-scopes cxp:read
#   otto-platform-server resource rotate-secret <resource-uri>                         -> otto_rs_...
#   otto-platform-server resource set-webhook <resource-uri> <public-url>/platform/webhooks -> otto_whsec_...
# https in production; plain http only for a loopback host.
CXP_PLATFORM_URL=http://localhost:8090
CXP_INTROSPECTION_SECRET=otto_rs_replace_me
CXP_PLATFORM_WEBHOOK_SECRET=otto_whsec_replace_me

# The web console's sign-in (off while CXP_CONSOLE_CLIENT_ID is unset). Register a first-party
# client whose redirect URI is {CXP_PUBLIC_URL}/auth/callback, then set both:
#   otto-platform-server client register --name "otto-cxp console" \
#     --redirect-uri http://localhost:8080/auth/callback --first-party   -> the client id
# CXP_ENCRYPTION_KEY is a secret: base64 of 32 bytes (`openssl rand -base64 32`). Two subkeys are
# derived from it (HKDF-SHA256): one seals stored tokens, one the sign-in cookie.
# For `pnpm dev:web` (vite on :5173, proxying to this server), use
# CXP_PUBLIC_URL=http://localhost:5173 and register that origin's callback instead, so the
# browser's Origin matches on writes.
# CXP_CONSOLE_CLIENT_ID=
# CXP_ENCRYPTION_KEY=

# Optional (defaults shown).
# CXP_BIND=0.0.0.0:8080
# CXP_ALLOWED_HOSTS=                        # EXTRA Host headers /mcp accepts (default empty; the
#                                           # CXP_PUBLIC_URL host is always allowed). Example: otto-cxp.fly.dev
# CXP_ALLOWED_ORIGINS=                      # browser origins (scheme://host[:port]) for /mcp; empty = no check
# CXP_ENFORCE_QUOTAS=false                  # refuse billable calls over plan quota (fails open)
# CXP_RUN_MIGRATIONS=true
# CXP_DB_MAX_CONNECTIONS=5                  # 2 to 20
# CXP_LOG_FORMAT=text                       # text or json
# CXP_CONSOLE_DIR=apps/web/dist             # the built console (`pnpm build`), served at /console/;
#                                           # the image sets /srv/console in its Dockerfile ENV
RUST_LOG=info
